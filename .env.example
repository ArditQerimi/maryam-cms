# Copy to .env.local and fill in. Real values never go into git (.env and .env.local are ignored).

# --- Email (order emails, email confirmation, password reset) -------------------------------
# Resend: https://resend.com. Until a domain is verified, Resend only delivers to the account
# owner's own address (403 for anyone else) — so no customer receives anything.
RESEND_API_KEY=
# Sender on a domain YOU own and verified at resend.com/domains, e.g.
#   RESEND_FROM="Dyqani Elif <porosi@your-domain.com>"
# Verifying the domain means adding the DNS records Resend shows (MX + SPF TXT for "send",
# the DKIM TXT "resend._domainkey", optionally DMARC "_dmarc") at the place the domain is
# registered. Those records are NOT environment variables and do not go in this file.
RESEND_FROM=

# Brevo (https://brevo.com, free 300/day, no domain needed): sends over HTTPS, so it works on hosts
# that block SMTP ports (Render). API key from SMTP & API > API keys; the sender address must be
# verified under Senders. Used when RESEND_API_KEY is empty, before SMTP.
BREVO_API_KEY=
BREVO_FROM=
BREVO_FROM_NAME=

# SMTP instead of Resend (e.g. Gmail: smtp.gmail.com / 587 / your address / an "App password").
# Used for ALL store emails when RESEND_API_KEY is empty. Keep the password only here / in the host's env.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=

# --- New-order notifications to the shop (all optional) -------------------------------------
# Telegram bot (create it with @BotFather) with Confirm / Cancel buttons:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# --- Shop assistant (AI agent: answers customers, takes orders) -----------------------------
# Free key: https://aistudio.google.com/apikey . Enables the chat bubble on the shop.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# AGENT_DAILY_LIMIT=400
# Customer-facing Telegram bot (create a SECOND bot with @BotFather; the one above is the order bot).
# Register it with: node --env-file=.env.local scripts/telegram.mjs agent-webhook https://your-domain
TELEGRAM_AGENT_BOT_TOKEN=
TELEGRAM_AGENT_WEBHOOK_SECRET=

# WhatsApp through the whatsapp-agent service (see ../whatsapp-agent):
WHATSAPP_AGENT_URL=
WHATSAPP_AGENT_TOKEN=
WHATSAPP_AGENT_TO=

# WhatsApp Cloud API (Meta) — needs a Meta business portfolio:
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OWNER_TO=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Twilio WhatsApp (sandbox or verified sender):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WEBHOOK_URL=
